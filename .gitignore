# This repository is scoped to analysis/figure-generation code only.
# Manuscript source, build artifacts, large derived data and internal notes
# are intentionally kept out (they are not part of "the code").

# LaTeX build artifacts
*.aux
*.out
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.log
main.pdf
main.tex
main.tex.bak_*

# manuscript-adjacent, not code
SuppTable_*.tex
SuppTable_*.csv
references.bib
review/
submission/

# one-off editorial scripts that patched manuscript text (not analysis code)
apply_*_edits*.py
apply_batch_numbers.py
apply_figure_split.py
apply_scanner_convention.py
apply_t*_edits.py
apply_t*_methods.py
patch_figure_literals.py

# third-party literature dumps (copyrighted, not ours to redistribute);
